TMDB_READ_TOKEN=
# Optional, e.g. pt-BR
TMDB_LANGUAGE=en-US
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Discogs → Settings → Developers → "Generate new token"
DISCOGS_TOKEN=
# Optional: fills missing book descriptions (Google Cloud → Books API key)
GOOGLE_BOOKS_KEY=

# --- Database (Postgres). Local: `docker compose up -d` (port 5433).
# Production: the Neon connection string (with ?sslmode=require).
DATABASE_URL=postgres://archive:archive@localhost:5433/archive

# --- Auth (Better Auth)
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# Where the app is served: http://localhost:3000 locally,
# https://archive.guilhermevictor.me in production.
BETTER_AUTH_URL=http://localhost:3000
# GitHub → Settings → Developer settings → OAuth Apps. Callback URL:
# <BETTER_AUTH_URL>/api/auth/callback/github (one app per environment).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The only email allowed to create an account (your GitHub primary email).
OWNER_EMAIL=
